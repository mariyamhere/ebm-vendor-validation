function vendorIdFor(email) {
  const s = String(email || '').trim().toLowerCase();
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0;
  return 'EBM-V-' + h.toString(36).toUpperCase().padStart(7, '0').slice(-7);
}


function setupVendorDesk() {
  const props = PropertiesService.getScriptProperties();

  const ss = SpreadsheetApp.create('EBM Vendor Desk (demo data)');
  const intake = ss.getSheets()[0].setName('Intake');
  writeHeader(intake, INTAKE_COLUMNS);
  writeHeader(ss.insertSheet('Assessments'), ASSESSMENT_COLUMNS);

  const doc = DocumentApp.create('EBM Supplier GRC Policy (mock)');
  const body = doc.getBody();
  body.clear();
  GRC_POLICY.trim().split('\n').forEach(function (line, i) {
    const p = body.appendParagraph(line);
    if (i === 0) p.setHeading(DocumentApp.ParagraphHeading.TITLE);
    else if (/^\d+\.\s/.test(line)) p.setHeading(DocumentApp.ParagraphHeading.HEADING2);
    else if (/^[CK]\d+\s—/.test(line)) p.setBold(true);
  });
  const blank = body.getParagraphs()[0];
  if (!blank.getText()) blank.removeFromParent();
  doc.saveAndClose();

  const form = FormApp.create(FORM_SPEC.title)
    .setDescription(FORM_SPEC.description)
    .setCollectEmail(false)
    .setConfirmationMessage('Thank you. Our procurement team will review your details and reply within five working days.');
  FORM_SPEC.fields.forEach(function (f) { addField(form, f); });
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  SpreadsheetApp.flush();
  Utilities.sleep(3000);
  const responses = SpreadsheetApp.openById(ss.getId()).getSheets().filter(function (s) { return s.getFormUrl(); })[0];

  const config = {
    spreadsheet_id: ss.getId(),
    form_responses_gid: String(responses.getSheetId()),
    grc_doc_id: doc.getId(),
    form_prefill_url: prefillTemplate(form),
    intake_email: Session.getActiveUser().getEmail(),
  };
  props.setProperties({ FORM_ID: form.getId(), SPREADSHEET_ID: ss.getId() });

  Logger.log('Sheet:  ' + ss.getUrl());
  Logger.log('Doc:    ' + doc.getUrl());
  Logger.log('Form:   ' + form.getPublishedUrl());
  Logger.log('Paste into config.json:\n' + JSON.stringify(config, null, 2));
}

function sendMockVendorEmails() {
  const me = Session.getActiveUser().getEmail();
  MOCK_EMAILS.forEach(function (m) {
    GmailApp.sendEmail(me, m.subject, m.body, { name: m.senderName, replyTo: alias(m.tag) });
    Utilities.sleep(1500);
  });
  Logger.log('Sent ' + MOCK_EMAILS.length + ' mock emails to ' + me);
}

function submitMockFormResponses() {
  const form = FormApp.openById(PropertiesService.getScriptProperties().getProperty('FORM_ID'));
  const items = {};
  form.getItems().forEach(function (it) { items[it.getTitle()] = it; });

  MOCK_RESPONSES.forEach(function (r) {
    const email = alias(r.tag);
    const answers = Object.assign({}, r, {
      vendor_id: vendorIdFor(email),
      contact_email: email,
      declaration: ['I confirm the information above is true and complete'],
    });
    const response = form.createResponse();
    FORM_SPEC.fields.forEach(function (f) {
      const value = answers[f.key];
      if (value === undefined || value === '' || (Array.isArray(value) && !value.length)) return;
      response.withItemResponse(answerFor(items[f.title], f, value));
    });
    response.submit();
    Logger.log('Submitted ' + r.company_name + ' as ' + answers.vendor_id);
    Utilities.sleep(1500);
  });
}

// ---------- helpers ----------

function alias(tag) {
  const me = Session.getActiveUser().getEmail().split('@');
  return (me[0].split('+')[0] + '+' + tag + '@' + me[1]).toLowerCase();
}

function writeHeader(sheet, columns) {
  sheet.getRange(1, 1, 1, columns.length).setValues([columns]).setFontWeight('bold');
  sheet.setFrozenRows(1);
}

function addField(form, f) {
  let item;
  if (f.type === 'text') item = form.addTextItem();
  else if (f.type === 'paragraph') item = form.addParagraphTextItem();
  else if (f.type === 'choice') item = form.addMultipleChoiceItem().setChoiceValues(f.choices);
  else if (f.type === 'checkbox') item = form.addCheckboxItem().setChoiceValues(f.choices);
  item.setTitle(f.title).setRequired(Boolean(f.required));
  if (f.key === 'vendor_id') item.setHelpText('Filled in from our email. Leave as it is.');
}

function answerFor(item, f, value) {
  if (f.type === 'text') return item.asTextItem().createResponse(String(value));
  if (f.type === 'paragraph') return item.asParagraphTextItem().createResponse(String(value));
  if (f.type === 'choice') return item.asMultipleChoiceItem().createResponse(String(value));
  return item.asCheckboxItem().createResponse([].concat(value));
}

// A pre-filled link with {{vendor_id}}, {{company_name}} and {{contact_email}}
// where the answers go; the intake workflow swaps in each vendor's values.
function prefillTemplate(form) {
  const marks = { vendor_id: 'XXVIDXX', company_name: 'XXCOMPXX', contact_email: 'XXMAILXX' };
  const response = form.createResponse();
  const items = {};
  form.getItems().forEach(function (it) { items[it.getTitle()] = it; });
  FORM_SPEC.fields.filter(function (f) { return f.prefill; }).forEach(function (f) {
    response.withItemResponse(items[f.title].asTextItem().createResponse(marks[f.prefill]));
  });
  let url = response.toPrefilledUrl();
  Object.keys(marks).forEach(function (k) { url = url.replace(marks[k], '{{' + k + '}}'); });
  return url;
}
