{
  "title": "EBM Vendor Information Form",
  "description": "Thank you for your interest in supplying EBM. This takes about 10 minutes. Please keep your NTN, STRN, SECP registration number and certificate details at hand.",
  "fields": [
    {
      "key": "vendor_id",
      "title": "Reference ID",
      "type": "hidden"
    },
    {
      "key": "company_name",
      "title": "Company legal name",
      "type": "text",
      "required": true
    },
    {
      "key": "contact_name",
      "title": "Contact person",
      "type": "text",
      "required": true
    },
    {
      "key": "contact_email",
      "title": "Contact email",
      "type": "email",
      "required": true
    },
    {
      "key": "phone",
      "title": "Phone",
      "type": "text",
      "required": true
    },
    {
      "key": "category",
      "title": "Supply category",
      "type": "choice",
      "required": true,
      "choices": [
        "Raw materials",
        "Packaging (food contact)",
        "Packaging (secondary)",
        "Logistics and warehousing",
        "Services and indirect"
      ]
    },
    {
      "key": "offering",
      "title": "What do you supply?",
      "type": "paragraph",
      "required": true
    },
    {
      "key": "website",
      "title": "Company website",
      "type": "text",
      "required": false
    },
    {
      "key": "city",
      "title": "City",
      "type": "text",
      "required": true
    },
    {
      "key": "years_in_business",
      "title": "Years in business",
      "type": "text",
      "required": true
    },
    {
      "key": "ntn",
      "title": "NTN",
      "type": "text",
      "required": true
    },
    {
      "key": "strn",
      "title": "STRN",
      "type": "text",
      "required": false
    },
    {
      "key": "secp_no",
      "title": "SECP registration number (CUIN)",
      "type": "text",
      "required": false
    },
    {
      "key": "directors",
      "title": "Owners or directors (full names)",
      "type": "paragraph",
      "required": true
    },
    {
      "key": "director_cnics",
      "title": "CNIC numbers of the owners or directors (optional)",
      "type": "paragraph",
      "required": false
    },
    {
      "key": "certifications",
      "title": "Certifications held",
      "type": "checkbox",
      "required": true,
      "choices": [
        "FSSC 22000",
        "ISO 22000",
        "BRCGS",
        "HACCP",
        "Halal (PHA or PSQCA)",
        "ISO 9001",
        "ISO 14001",
        "SMETA or Sedex",
        "None"
      ]
    },
    {
      "key": "cert_expiry",
      "title": "Certificate expiry dates",
      "type": "paragraph",
      "required": false
    },
    {
      "key": "turnover",
      "title": "Annual turnover (PKR)",
      "type": "choice",
      "required": true,
      "choices": [
        "Below 50 million",
        "50 to 250 million",
        "250 million to 1 billion",
        "Above 1 billion"
      ]
    },
    {
      "key": "capacity",
      "title": "Monthly capacity",
      "type": "text",
      "required": true
    },
    {
      "key": "key_clients",
      "title": "Key clients",
      "type": "paragraph",
      "required": false
    },
    {
      "key": "payment_terms",
      "title": "Payment terms offered",
      "type": "choice",
      "required": true,
      "choices": [
        "Full advance",
        "15 days",
        "30 days",
        "60 days",
        "90 days"
      ]
    },
    {
      "key": "related_party",
      "title": "Is any owner or director related to an EBM employee?",
      "type": "choice",
      "required": true,
      "choices": [
        "No",
        "Yes"
      ]
    },
    {
      "key": "related_party_details",
      "title": "If yes, give the name and relationship",
      "type": "paragraph",
      "required": false
    },
    {
      "key": "litigation",
      "title": "Any litigation, debarment or regulatory action in the last 5 years?",
      "type": "choice",
      "required": true,
      "choices": [
        "No",
        "Yes"
      ]
    },
    {
      "key": "litigation_details",
      "title": "If yes, give details",
      "type": "paragraph",
      "required": false
    },
    {
      "key": "declaration",
      "title": "Declaration",
      "type": "checkbox",
      "required": true,
      "choices": [
        "I confirm the information above is true and complete"
      ]
    }
  ]
}
